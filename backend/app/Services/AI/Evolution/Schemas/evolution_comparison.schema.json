{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvolutionComparison",
  "type": "object",
  "required": ["claims", "limitations"],
  "additionalProperties": false,
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "type", "body_region", "evidence_ids", "confidence", "publishable"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["objective_metric", "visual_observation", "limitation", "data_quality_warning"]
          },
          "body_region": {
            "type": ["string", "null"],
            "enum": ["abdomen", "waist", "arms", "legs", "shoulders", "back", "general_silhouette", null]
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "publishable": { "type": "boolean" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
